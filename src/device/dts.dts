/dts-v1/;

/*
 * Compiled into two blobs via the C preprocessor (the cpu node's isa
 * properties are #ifdef VECTOR):
 *   cpp -P -nostdinc -x assembler-with-cpp dts.dts | dtc -I dts -O dtb -o dtb.dtb
 *   cpp -P -DVECTOR -nostdinc -x assembler-with-cpp dts.dts | dtc -I dts -O dtb -o dtb-v.dtb
 * dtb.dtb is the default; dtb-v.dtb is loaded when the -V flag is given.
 */

/ {
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        compatible = "riscv-virtio";
        model = "riscv-virtio,qemu";

        chosen {
		bootargs = "console=ttyS0 earlycon=sbi root=/dev/vda1 rw ignore_loglevel random.trust_bootloader=on";
                stdout-path = "/uart@10000000";

		/* Development-only static seed: replace with per-boot random bytes later. */
		rng-seed = [
			6f 2c 91 7a 44 1e d3 b8
			0a cc 59 32 f4 81 25 9d
			e7 10 ba 6c 38 5f 02 c1
			93 d4 76 af 20 8b ee 41
			15 62 9a cd 57 03 b4 f8
			80 2d 11 6e a9 4c 73 05
			dc 37 f1 98 24 bb 60 0f
			4a e2 7d 36 c5 19 8c a0
		];
        };

        // Reserve the M-mode firmware (OpenSBI) region so S-mode (U-Boot, the
        // kernel) does not treat it as free RAM. QEMU's generated DTB carries
        // the equivalent "mmode_resv0" node; without it, and with PMP not
        // enforced, the kernel allocates over OpenSBI and corrupts its trap
        // handler.
        reserved-memory {
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;

                mmode_resv0@80000000 {
                        reg = <0x0 0x80000000 0x0 0x200000>;
                        no-map;
                };
        };

        uart@10000000 {
                interrupts = <0xa>;
                interrupt-parent = <0x3>;
                clock-frequency = <0x384000>;
                reg = <0x0 0x10000000 0x0 0x100>;
                compatible = "ns16550a";
        };

        virtio_mmio@10001000 {
                interrupts = <0x1>;
                interrupt-parent = <0x3>;
                reg = <0x0 0x10001000 0x0 0x1000>;
                compatible = "virtio,mmio";
        };

        virtio_mmio@10002000 {
                interrupts = <0x02>;
                interrupt-parent = <0x03>;
                reg = <0x00 0x10002000 0x00 0x1000>;
                compatible = "virtio,mmio";
        };

        virtio_mmio@10003000 {
                interrupts = <0x03>;
                interrupt-parent = <0x03>;
                reg = <0x00 0x10003000 0x00 0x1000>;
                compatible = "virtio,mmio";
        };

        syscon@100000 {
                phandle = <0x12>;
                reg = <0x0 0x100000 0x0 0x1000>;
                compatible = "syscon";
        };

        poweroff {
                value = <0x5555>;
                offset = <0x00>;
                regmap = <0x12>;
                compatible = "syscon-poweroff";
        };

        reboot {
                value = <0x7777>;
                offset = <0x00>;
                regmap = <0x12>;
                compatible = "syscon-reboot";
        };

        cpus {
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                timebase-frequency = <2000000>; // 2 MHz, a 2X lie

                cpu-map {
                        cluster0 {
                                core0 {
                                        cpu = <0x1>;
                                };
                        };
                };

                cpu@0 {
                        phandle = <0x1>;
                        device_type = "cpu";
                        reg = <0x0>;
                        status = "okay";
                        compatible = "riscv";
                        riscv,isa-base = "rv64i";
#ifdef VECTOR
                        riscv,isa = "rv64imafdcv";
                        riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicsr", "zifencei", "v", "zve32x", "zve32f", "zve64x", "zve64f", "zve64d", "zvl32b", "zvl64b", "zvl128b";
#else
                        riscv,isa = "rv64imafdc";
                        riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicsr", "zifencei";
#endif
                        mmu-type = "riscv,sv39";

                        interrupt-controller {
                                #interrupt-cells = <0x1>;
                                interrupt-controller;
                                compatible = "riscv,cpu-intc";
                                phandle = <0x2>;
                        };
                };
        };

        soc {
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                compatible = "simple-bus";
                ranges;

                interrupt-controller@c000000 {
                        phandle = <0x3>;
                        riscv,ndev = <0x35>;
                        reg = <0x0 0xc000000 0x0 0x4000000>;
                        interrupts-extended = <0x2 0xb 0x2 0x9>;
                        interrupt-controller;
                        compatible = "riscv,plic0";
                        #interrupt-cells = <0x1>;
                        #address-cells = <0x0>;
                };

                clint@2000000 {
                        interrupts-extended = <0x2 0x3 0x2 0x7>;
                        reg = <0x0 0x2000000 0x0 0x10000>;
                        compatible = "riscv,clint0";
                };
        };

        memory@80000000 {
                device_type = "memory";
                reg = <0x0 0x80000000 0x0 0x20000000>;
        };
};
